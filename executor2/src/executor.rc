#include <windows.h>
#include "executor.h"

IDI_EXECUTOR ICON "executor.ico"

1 24 "executor.manifest"

IDD_MAIN DIALOGEX 0, 0, 344, 108
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Executor"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "File:", IDC_STATIC, 8, 10, 52, 10
    COMBOBOX        IDC_FILE, 62, 8, 204, 160,
                    CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_BROWSE, 272, 7, 64, 14

    LTEXT           "Arguments:", IDC_STATIC, 8, 28, 52, 10
    EDITTEXT        IDC_ARGS, 62, 26, 274, 14, ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Start in:", IDC_STATIC, 8, 46, 52, 10
    EDITTEXT        IDC_WORKDIR, 62, 44, 274, 14, ES_AUTOHSCROLL | WS_TABSTOP

    AUTOCHECKBOX    "Run as administrator", IDC_ADMIN, 62, 64, 160, 12, WS_TABSTOP

    PUSHBUTTON      "Clear list", IDC_CLEAR, 8, 86, 64, 14
    DEFPUSHBUTTON   "Run", IDOK, 148, 86, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 204, 86, 50, 14
    PUSHBUTTON      "About", IDC_ABOUT, 260, 86, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 240, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Executor"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_EXECUTOR, IDC_STATIC, 12, 12, 20, 20
    LTEXT           "Executor 2.1", IDC_STATIC, 44, 10, 184, 12
    LTEXT           "A program launcher for Windows.", IDC_STATIC, 44, 22, 184, 10
    LTEXT           "Original Executor (1991) by", IDC_STATIC, 44, 42, 184, 10
    LTEXT           "Chris Nystrom and J.R. McConnell.", IDC_STATIC, 44, 54, 184, 10
    LTEXT           "Executor 2.1 (2026).", IDC_STATIC, 44, 70, 184, 10
    LTEXT           "Public domain.", IDC_STATIC, 44, 82, 184, 10
    DEFPUSHBUTTON   "OK", IDOK, 95, 98, 50, 14
END

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,1,0,0
PRODUCTVERSION  2,1,0,0
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       0x1L
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Chris Nystrom and J.R. McConnell"
            VALUE "FileDescription",  "Executor 2.1 — program launcher"
            VALUE "FileVersion",      "2.1.0.0"
            VALUE "InternalName",     "Executor"
            VALUE "LegalCopyright",   "Public domain. Original Executor (1991) by Chris Nystrom and J.R. McConnell. Executor 2.1 (2026)."
#ifdef EXE32
            VALUE "OriginalFilename", "executor32.exe"
#else
            VALUE "OriginalFilename", "executor.exe"
#endif
            VALUE "ProductName",      "Executor"
            VALUE "ProductVersion",   "2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
